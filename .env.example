# ═══════════════════════════════════════════════════════════
# VBOS - Visual Business OS Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values
# For Vercel: Set these in Project Settings > Environment Variables
# ═══════════════════════════════════════════════════════════

# Database (PostgreSQL)
# For Vercel: Use Vercel Postgres (Neon) - auto-injected as DATABASE_URL
# For local: Use your Vercel Postgres connection string or local Postgres
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Optional: Direct database URL for pooled connections (Vercel Postgres provides this)
# DIRECT_URL="postgresql://user:password@host:5432/database?sslmode=require"
